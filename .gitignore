# 依赖（体积大、可重建，不纳入仓库）
node_modules

# 环境变量（仅保留 .env.example 作为模板；真实 .env 含密钥，不入库）
.env
.env.*
!.env.example

# 运行时数据库文件（db/ 下的 .sql 是建表脚本，纳入；运行时生成的库文件忽略）
*.db
*.sqlite
*.sqlite3

# 构建 / 编译日志（自定义编译脚本产生）
build.err
build.log
compile.done
compile.log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 依赖缓存 / 测试覆盖率
.cache
coverage

# 编辑器与系统文件
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 说明：dist/（构建产物）与 XinBlog0.1.0网页端部署资源包.zip（部署包）
#       已纳入仓库，方便用户直接部署，无需自行构建。
