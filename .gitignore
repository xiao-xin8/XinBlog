# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# 构建产物（自定义编译脚本产生）
build.err
build.log
compile.done
compile.log

# 运行时数据库（db/ 下为表结构 .sql，运行时生成的库文件应忽略）
*.db
*.sqlite
*.sqlite3

# 环境变量（保留 .env.example 作为模板）
.env
.env.*
!.env.example

# 依赖缓存 / 测试覆盖率
.cache
coverage

# 第三方 Live2D 看板娘模型（体积大且非本项目源码，需自行放入 public/live2d-models/）
public/live2d-models/

# 第三方 Live2D 库的调试 sourcemap（非本项目代码产物，不进仓库）
public/live2d/**/*.map

# Wrangler 本地状态与密钥文件
.wrangler/
.dev.vars
.dev.vars.*

# TypeScript 增量编译缓存
*.tsbuildinfo

# Windows 系统 / Office 临时文件
Thumbs.db
Desktop.ini
~$*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
